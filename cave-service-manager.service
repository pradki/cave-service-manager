[Unit]
Description=Cave Service Manager (small automation tasks over MQTT)
After=network.target

[Service]
Type=simple
User=sqna
WorkingDirectory=/home/sqna/cave/raspberry/cave-service-manager
ExecStart=/home/sqna/venv/cave/bin/python /home/sqna/cave/raspberry/cave-service-manager/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
